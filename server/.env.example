# Copia este archivo a .env (NO lo subas a git) y ajusta los valores.
# El servidor lo lee solo al arrancar; las variables de entorno reales tienen prioridad.

# OBLIGATORIO. Mínimo 32 caracteres. Genera uno con:  dart run bin/gen_secret.dart
JWT_SECRET=

PORT=3000
DB_PATH=./data/brilliant.db

# Opcional: secreto extra para las contraseñas (pepper). Si lo cambias, las
# contraseñas ya registradas dejan de funcionar. Guárdalo FUERA de la base de datos.
# PASSWORD_PEPPER=

# Argon2id (por defecto m=19 MiB, t=2, p=1: el mínimo que recomienda OWASP)
# ARGON2_MEMORY_KIB=19456
# ARGON2_TIME_COST=2

# En producción:
# ENV=production          -> exige HTTPS
# TRUST_PROXY=1           -> si estás detrás de nginx/Caddy/Render/Fly...
# CORS_ORIGINS=https://tu-app-web.com   -> solo si usas Flutter Web

# Multijugador: segundos que se guarda el lugar de un jugador desconectado
# RECONNECT_GRACE_SECONDS=30
# Segundos por ronda, para poner los números iniciales y máximo de rondas
# TURN_SECONDS=60
# INITIAL_VALUES_SECONDS=90
# MAX_ROUNDS=100

# Una sola sesión por cuenta: segundos sin señales de vida tras los que una
# sesión deja de contar como "en uso" (la app avisa cada minuto).
# SESSION_ACTIVE_SECONDS=150
